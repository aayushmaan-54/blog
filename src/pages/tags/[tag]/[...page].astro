---
import { SITE } from '@/config/site.config';
import type { GetStaticPathsOptions } from 'astro';
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ContentLayout from '@/layouts/ContentLayout.astro';
import PostLink from '@/components/PostLink.astro';
import Pagination from '@/components/Pagination.astro';
import getUniqueTags from '@/utils/content/getUniqueTags';
import getPostsByTag from '@/utils/content/getPostsByTag';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const blogs = await getCollection('blogs', ({ data }) => !data.draft);
  const tags = getUniqueTags(blogs);

  return tags.flatMap(({ tag, tagName }) => {
    const tagPosts = getPostsByTag(blogs, tag);

    return paginate(tagPosts, {
      params: { tag },
      props: { tagName },
      pageSize: SITE.postPerPage.tags,
    });
  });
}

const { page, tagName } = Astro.props;
---

<BaseLayout
  title={`tags / ${tagName}`}
  description={`Articles tagged "${tagName}" by Aayushmaan Soni.`}
>
  <ContentLayout pageTitle={[`tag:`, `${tagName}`]}>
    <ul>
      {
        page.data.map((post, index) => (
          <PostLink
            post={post}
            variant='h3'
            showDivider={index !== page.data.length - 1}
          />
        ))
      }
    </ul>
  </ContentLayout>

  <Pagination {page} />
</BaseLayout>

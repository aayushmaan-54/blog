---
interface StringTitleProp {
  pageTitle: string;
}

interface ArrayTitleProp {
  pageTitle: [string, string];
}

export type Props = StringTitleProp | ArrayTitleProp;

const props = Astro.props as Props;

const backUrl = Astro.url.pathname;
---

<main
  data-back-url={backUrl}
  id='main-content'
  class='mx-auto mb-4 w-full max-w-app'
>
  {
    Array.isArray(props.pageTitle) ? (
      <h1 class='text-3xl font-semibold tracking-tight sm:text-3xl'>
        {props.pageTitle[0]}{' '}
        <span>{props.pageTitle[1]}</span>
      </h1>
    ) : (
      <h1 class='text-2xl font-semibold sm:text-3xl'>{props.pageTitle}</h1>
    )
  }
  <slot />
</main>

<script>
  import { SITE } from '@/config/site.config';

  const mainContent = document.querySelector('#main-content');
  const backUrl = mainContent?.getAttribute('data-back-url');
  if (backUrl) {
    sessionStorage.setItem(SITE.browserStorage.backUrl, backUrl);
  }
</script>

---
import type { Page } from 'astro';
import type { CollectionEntry } from 'astro:content';
import Link from './Link.astro';

export interface Props {
  page: Page<CollectionEntry<'blogs' | 'short_reads'>>;
}

const { page } = Astro.props;
---

{
  page.lastPage > 1 && (
    <nav class='mt-auto flex justify-center pt-12 mb-8' aria-label='Pagination'>
      <Link
        disabled={!page.url.prev}
        href={page.url.prev as string}
        class:list={['me-4 select-none', { 'opacity-50': !page.url.prev }]}
        ariaLabel='Previous'
      >
        <span aria-hidden='true' class='me-1'>←</span>
        prev
      </Link>
      {page.currentPage} / {page.lastPage}
      <Link
        disabled={!page.url.next}
        href={page.url.next as string}
        class:list={['ms-4 select-none', { 'opacity-50': !page.url.next }]}
        ariaLabel='Next'
      >
        next
        <span aria-hidden='true' class='ms-1'>→</span>
      </Link>
    </nav>
  )
}

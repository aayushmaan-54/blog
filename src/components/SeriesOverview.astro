---
import type { CollectionEntry } from 'astro:content';
import getPostPath from '@/utils/content/getPostPath';
import { slugifyStr } from '@/utils/text/slugify';

export interface Props {
  post: CollectionEntry<'blogs'>;
  parts: CollectionEntry<'blogs'>[];
}

const { post, parts } = Astro.props;
const seriesName = post.data.series as string;
const currentIndex = parts.findIndex(part => part.id === post.id);
---

<nav
  aria-label='Series'
  class='mb-8 rounded border border-border bg-secondary px-4 py-3 text-sm'
  data-pagefind-ignore
>
  <p class='font-mono text-xs text-foreground-muted lowercase'>
    // series · part {currentIndex + 1} of {parts.length}
  </p>
  <a
    href={`/series/${slugifyStr(seriesName)}/`}
    class='font-semibold text-foreground-primary underline-offset-4 hover:underline'
  >
    {seriesName}
  </a>
  <ol class='mt-2 space-y-1'>
    {
      parts.map((part, index) => (
        <li class='flex items-baseline gap-2'>
          <span class='w-5 shrink-0 font-mono text-xs text-foreground-muted tabular-nums'>
            {index + 1}.
          </span>
          {index === currentIndex ? (
            <span aria-current='page' class='font-medium text-accent'>
              {part.data.title}
            </span>
          ) : (
            <a
              href={getPostPath(part)}
              class='text-foreground-secondary underline-offset-4 transition-colors hover:text-foreground-primary hover:underline'
            >
              {part.data.title}
            </a>
          )}
        </li>
      ))
    }
  </ol>
</nav>

---
import { SOCIALS } from '@/config/socials.config';
import Link from './Link.astro';
---

<div class='contents'>
  {
    SOCIALS.map(social => (
      <Link
        href={social.href}
        class='font-mono text-sm text-foreground-muted lowercase opacity-75 transition-opacity hover:opacity-100'
        title={social.linkTitle}
        ariaLabel={social.linkTitle}
      >
        <span aria-hidden='true'>[{social.name}]</span>
        <span class='sr-only'>{social.linkTitle}</span>
      </Link>
    ))
  }
</div>

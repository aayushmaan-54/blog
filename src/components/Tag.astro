---
export interface Props {
  tag: string;
  tagName: string;
  size?: 'sm' | 'lg';
}

const { tag, tagName, size = 'sm' } = Astro.props;
---

<li class='inline-block'>
  <a
    href={`/tags/${tag}/`}
    class:list={[
      'group/tag flex items-center pe-4 text-accent duration-200 focus-visible:text-foreground-primary',
      size === 'sm' ? 'text-sm' : 'text-lg',
    ]}
  >
    <span
      aria-hidden='true'
      class:list={[
        'inline-block italic opacity-70 group-hover/tag:opacity-100',
        size === 'sm' ? 'me-0.5' : 'me-1',
      ]}
    >
      #
    </span>
    <span
      class:list={[
        'underline-offset-4',
        size === 'lg' ? 'underline decoration-1' : 'group-hover/tag:underline',
      ]}
    >
      {tagName}
    </span>
  </a>
</li>

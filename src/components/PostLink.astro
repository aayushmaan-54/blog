---
import { slugifyStr } from '@/utils/text/slugify';
import type { CollectionEntry } from 'astro:content';
import PostMeta from './PostMeta.astro';
import Tag from './Tag.astro';
import getPostPath from '@/utils/content/getPostPath';

export interface Props {
  variant?: 'h2' | 'h3';
  post: CollectionEntry<'blogs'>;
  showDivider?: boolean;
}

const { variant = 'h2', post, showDivider = true } = Astro.props;

const { title, description, tags, pubDatetime, modDatetime, timezone } =
  post.data;

const headerPropsBaseClass = 'leading-tight tracking-tight';
const postUrl = getPostPath(post);
---

<li class='my-8 mt-6 mb-16'>
  {
    variant === 'h2' ? (
      <h2 class:list={[headerPropsBaseClass, 'mb-2 text-3xl font-bold']}>
        <a
          href={postUrl}
          class:list={[
            'transition-colors hover:text-foreground-primary/90 focus-visible:no-underline focus-visible:underline-offset-0',
          ]}
        >
          <span>{title}</span>
        </a>
      </h2>
    ) : (
      <h3
        class:list={[
          headerPropsBaseClass,
          'mb-2 text-xl font-medium hover:text-accent',
        ]}
      >
        <a href={postUrl} class='transition-colors'>
          <span>{title}</span>
        </a>
      </h3>
    )
  }

  {description && <p class='text-foreground-muted'>{description}</p>}
  <div
    class='mt-3 flex flex-wrap items-center gap-y-1 text-sm text-foreground-muted'
  >
    {
      tags && tags.length > 0 && (
        <>
          <ul class='-me-4 flex flex-wrap items-center'>
            {tags.map(tag => (
              <Tag tag={slugifyStr(tag)} tagName={tag} />
            ))}
          </ul>
          <span aria-hidden='true' class='mx-2'>
            ·
          </span>
        </>
      )
    }
    <PostMeta {pubDatetime} {modDatetime} {timezone} text={post.body || ''} />
  </div>
  {showDivider && <hr class='mt-6 border-foreground-muted/10' />}
</li>

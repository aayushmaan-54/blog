{
  "Blog Frontmatter": {
    "scope": "markdown,mdx",
    "prefix": "blog-fm",
    "body": [
      "---",
      "title: $1",
      "description: $2 # required: one line, used in listings, SEO and social cards",
      "pubDatetime: $CURRENT_YEAR-$CURRENT_MONTH-${CURRENT_DATE}T$CURRENT_HOUR:$CURRENT_MINUTE:$CURRENT_SECOND.000+05:30 # future date = scheduled",
      "modDatetime: # set when you update the post, e.g. 2026-01-31T10:00:00.000+05:30",
      "author: Aayushmaan Soni",
      "slug: $3 # required: URL after /blogs/, e.g. k8s-architecture or k8s-architecture/basics",
      "tags: [\"$4\"] # blank = [\"others\"]",
      "draft: ${5|true,false|} # true = hidden in production, visible in dev",
      "featured: ${6|false,true|} # true = pinned to Featured on the home page",
      "series: $7 # e.g. CS Fundamentals; same name in every part",
      "seriesOrder: $8 # part number in the series: 1, 2, 3…",
      "ogImage: # ./assets/cover.png or a URL; blank = auto-generated",
      "canonicalURL: # original URL if this was published elsewhere first",
      "timezone: # IANA zone for displayed dates; blank = Asia/Kolkata",
      "---"
    ],
    "description": "Blog frontmatter (all fields)"
  },
  "Blog Template": {
    "scope": "markdown,mdx",
    "prefix": "blog",
    "body": [
      "---",
      "title: $1",
      "description: $2 # required: one line, used in listings, SEO and social cards",
      "pubDatetime: $CURRENT_YEAR-$CURRENT_MONTH-${CURRENT_DATE}T$CURRENT_HOUR:$CURRENT_MINUTE:$CURRENT_SECOND.000+05:30 # future date = scheduled",
      "modDatetime: # set when you update the post, e.g. 2026-01-31T10:00:00.000+05:30",
      "author: Aayushmaan Soni",
      "slug: $3 # required: URL after /blogs/, e.g. k8s-architecture or k8s-architecture/basics",
      "tags: [\"$4\"] # blank = [\"others\"]",
      "draft: ${5|true,false|} # true = hidden in production, visible in dev",
      "featured: ${6|false,true|} # true = pinned to Featured on the home page",
      "series: $7 # e.g. CS Fundamentals; same name in every part",
      "seriesOrder: $8 # part number in the series: 1, 2, 3…",
      "ogImage: # ./assets/cover.png or a URL; blank = auto-generated",
      "canonicalURL: # original URL if this was published elsewhere first",
      "timezone: # IANA zone for displayed dates; blank = Asia/Kolkata",
      "---",
      "",
      "## Table of Contents",
      "",
      "## ${9:Heading}",
      "$0"
    ],
    "description": "Full blog template (all fields + TOC)"
  }
}
